# cp .env.example .env  (.env는 git에 올라가지 않습니다)

# Claude API 키 (https://platform.claude.com)
ANTHROPIC_API_KEY=

# 공공데이터포털 K-Startup API 인증키 (Decoding 키)
# https://www.data.go.kr/data/15125364/openapi.do → 활용신청 (자동승인)
DATA_GO_KR_API_KEY=

MLFLOW_TRACKING_URI=http://127.0.0.1:5001
# MLflow가 S3 저장소를 쓸 때 아티팩트를 항상 MLflow 서버 경유로 주고받기
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false

# 판정에 쓸 모델 (비교 실험 때 claude-haiku-5-5 등으로 바꿔 봅니다)
AGENT_MODEL=claude-sonnet-5-5
